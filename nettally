#!/usr/bin/env bash
# nettally CLI entry point wrapper.
#
# Runs from two locations:
#   * the source tree (development):     ./nettally <command>
#   * the standalone install (deployed): $APP_DIR/nettally, symlinked onto PATH
# Every path below resolves relative to wherever this script actually lives;
# symlinks are resolved first so a PATH symlink lands in the right directory.

# Resolve symlinks so $SCRIPT_DIR points at the real script, not at the
# directory that merely holds the PATH symlink (install.sh symlinks
# ~/bin/nettally -> APP_DIR/nettally).
SELF="$0"
while [ -h "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
SCRIPT_DIR="$( cd "$( dirname "$SELF" )" && pwd )"

# Python runtime: prefer the interpreter pinned by install.sh (so the daemon and
# the CLI share one), falling back to `env python3` before installation.
PYTHON_FILE="$HOME/Library/Application Support/NetTally/python_path"
if [ -f "$PYTHON_FILE" ]; then
    PYTHON="$(head -n 1 "$PYTHON_FILE")"
    [ -x "$PYTHON" ] || PYTHON="/usr/bin/env python3"
else
    PYTHON="/usr/bin/env python3"
fi

case "$1" in
    report)
        shift
        $PYTHON "$SCRIPT_DIR/report.py" "$@"
        ;;
    html)
        shift
        $PYTHON "$SCRIPT_DIR/html_generator.py" --open "$@"
        ;;
    run-once)
        shift
        $PYTHON "$SCRIPT_DIR/collector.py" --once "$@"
        ;;
    run-daemon)
        shift
        $PYTHON "$SCRIPT_DIR/collector.py" "$@"
        ;;
    pause)
        shift
        $PYTHON "$SCRIPT_DIR/pause.py" pause "$@"
        ;;
    resume)
        shift
        $PYTHON "$SCRIPT_DIR/pause.py" resume "$@"
        ;;
    passthrough)
        shift
        $PYTHON "$SCRIPT_DIR/passthrough.py" "$@"
        ;;
    status)
        echo "=== NetTally Service Status ==="
        launchctl list 2>/dev/null | grep -E "com\.nettally\.daemon" || echo "Service is not currently loaded in launchctl."
        $PYTHON "$SCRIPT_DIR/pause.py" state 2>/dev/null || echo "Tracking state unknown (pause.py unavailable)."
        # Only worth a line when something is registered, so the default
        # status output stays byte-for-byte what it was.
        PT="$($PYTHON "$SCRIPT_DIR/passthrough.py" list --quiet 2>/dev/null || true)"
        if [ -n "$PT" ]; then
            echo ""
            echo "Pass-through apps (excluded from reports): $PT"
        fi
        LOG_DIR="$HOME/Library/Logs/NetTally"
        if [ -s "$LOG_DIR/collector.log" ]; then
            echo ""
            echo "--- Recent Log (last 5 lines) ---"
            tail -n 5 "$LOG_DIR/collector.log"
            echo ""
            echo "Full log: $LOG_DIR/collector.log (older entries rotate to collector.log.1, .2, ...)"
        fi
        # Non-empty only when the collector died before it could open its own
        # log -- an import error, a bad interpreter, a failed --db path. The
        # timestamp matters because such a file is never rewritten by a healthy
        # daemon, so an untouched pre-logging-rewrite one would otherwise read
        # as a current crash. BSD stat (not `date -r`, which takes epoch here).
        if [ -s "$LOG_DIR/collector.err.log" ]; then
            echo ""
            ERR_MTIME=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$LOG_DIR/collector.err.log" 2>/dev/null)
            if [ -n "$ERR_MTIME" ]; then
                echo "--- Startup/Crash Output (last 20 lines, last written $ERR_MTIME) ---"
            else
                echo "--- Startup/Crash Output (last 20 lines) ---"
            fi
            tail -n 20 "$LOG_DIR/collector.err.log"
        fi
        ;;
    install)
        shift
        bash "$SCRIPT_DIR/install.sh" "$@"
        ;;
    uninstall)
        shift
        bash "$SCRIPT_DIR/uninstall.sh" "$@"
        ;;
    *)
        echo "Usage: nettally <command> [options]"
        echo ""
        echo "Commands:"
        echo "  report      Generate CLI text usage report (--days 30, --by-day, --by-hour, --by-5m, --app, etc.)"
        echo "  html        Generate and open interactive multi-resolution HTML dashboard"
        echo "  status      Check background service status, pause state, and recent log output"
        echo "  pause       Stop recording usage (indefinitely, or --for 2h / --for 45m / --for 1h30m)"
        echo "  resume      Start recording usage again immediately"
        echo "  passthrough Register pass-through apps excluded from reports (add/remove/list)"
        echo "  run-once    Execute a single nettop polling cycle for testing"
        echo "  run-daemon  Start collector daemon manually in foreground"
        echo "  install     Install LaunchAgent background service"
        echo "  uninstall   Remove LaunchAgent background service"
        exit 1
        ;;
esac