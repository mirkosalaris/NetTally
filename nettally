#!/usr/bin/env bash
# nettally CLI entry point wrapper.
#
# Runs from two locations:
#   * the source tree (development):     ./nettally <command>
#   * the standalone install (deployed): $APP_DIR/nettally, symlinked onto PATH
# Every path below resolves relative to wherever this script actually lives;
# symlinks are resolved first so a PATH symlink lands in the right directory.

# Resolve symlinks so $SCRIPT_DIR points at the real script, not at the
# directory that merely holds the PATH symlink (install.sh symlinks
# ~/bin/nettally -> APP_DIR/nettally).
SELF="$0"
while [ -h "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
SCRIPT_DIR="$( cd "$( dirname "$SELF" )" && pwd )"

# Python runtime: prefer the interpreter pinned by install.sh (so the daemon and
# the CLI share one), falling back to `env python3` before installation.
PYTHON_FILE="$HOME/Library/Application Support/NetTally/python_path"
if [ -f "$PYTHON_FILE" ]; then
    PYTHON="$(head -n 1 "$PYTHON_FILE")"
    [ -x "$PYTHON" ] || PYTHON="/usr/bin/env python3"
else
    PYTHON="/usr/bin/env python3"
fi

case "$1" in
    report)
        shift
        $PYTHON "$SCRIPT_DIR/report.py" "$@"
        ;;
    html)
        shift
        $PYTHON "$SCRIPT_DIR/html_generator.py" --open "$@"
        ;;
    run-once)
        shift
        $PYTHON "$SCRIPT_DIR/collector.py" --once "$@"
        ;;
    run-daemon)
        shift
        $PYTHON "$SCRIPT_DIR/collector.py" "$@"
        ;;
    status)
        echo "=== NetTally Service Status ==="
        launchctl list 2>/dev/null | grep -E "com\.nettally\.daemon" || echo "Service is not currently loaded in launchctl."
        if [ -f "$HOME/Library/Logs/NetTally/collector.out.log" ]; then
            echo ""
            echo "--- Recent Out Log (last 5 lines) ---"
            tail -n 5 "$HOME/Library/Logs/NetTally/collector.out.log"
        fi
        if [ -f "$HOME/Library/Logs/NetTally/collector.err.log" ]; then
            echo ""
            echo "--- Recent Error Log (last 5 lines) ---"
            tail -n 5 "$HOME/Library/Logs/NetTally/collector.err.log"
        fi
        ;;
    install)
        shift
        bash "$SCRIPT_DIR/install.sh" "$@"
        ;;
    uninstall)
        shift
        bash "$SCRIPT_DIR/uninstall.sh" "$@"
        ;;
    *)
        echo "Usage: nettally <command> [options]"
        echo ""
        echo "Commands:"
        echo "  report      Generate CLI text usage report (--days 30, --by-day, --by-hour, --by-5m, --app, etc.)"
        echo "  html        Generate and open interactive multi-resolution HTML dashboard"
        echo "  status      Check background service status and recent log output"
        echo "  run-once    Execute a single nettop polling cycle for testing"
        echo "  run-daemon  Start collector daemon manually in foreground"
        echo "  install     Install LaunchAgent background service"
        echo "  uninstall   Remove LaunchAgent background service"
        exit 1
        ;;
esac